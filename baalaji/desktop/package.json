{
  "name": "baalaji-pharmacy-desktop",
  "version": "1.0.0",
  "description": "Baalaji Pharmacy Management System - Windows Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "author": "Baalaji Healthcare",
  "license": "Proprietary",
  "dependencies": {
    "electron": "^33.2.0"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.baalaji.pharmacymanager",
    "productName": "Baalaji Pharmacy Management System",
    "win": {
      "target": "nsis",
      "icon": "../frontend/assets/logo.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
